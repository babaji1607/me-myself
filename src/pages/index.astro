---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SlowMarquee from '../components/SlowMarquee.astro';
import WorkArchetype from '../components/WorkArchetype.astro';
import WisdomSection from '../components/WisdomSection.astro';
import MusicSection from '../components/MusicSection.astro';
import MemorySection from '../components/MemorySection.astro';
import Footer from '../components/Footer.astro';
import { identity } from '../data/identity';
---

<Layout
  title={`${identity.name} — ${identity.title}`}
  description={identity.subheadline}
>
  <Header />
  <main id="main-content" class="flex-1">
    <Hero />
    <SlowMarquee />
    <WorkArchetype />
    <WisdomSection />
    <MusicSection />
    <MemorySection />
  </main>
  <Footer />
</Layout>

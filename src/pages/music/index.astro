---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { identity } from '../../data/identity';

const tracks = identity.music;
---

<Layout
  title={`Sound Sanctuary & Records — ${identity.name}`}
  description="Curated acoustic soundscapes, sacred Carnatic ragas, and progressive vinyl architecture."
>
  <Header />

  <main id="main-content" class="flex-1 pt-24 sm:pt-32 md:pt-36 pb-24 md:pb-36">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 md:px-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="mb-6 sm:mb-8 flex items-center gap-2 text-xs font-mono text-[#615B52] dark:text-[#A39D92]">
        <a href="/#hero" class="hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1DB954] font-semibold">Music &amp; Records</span>
      </nav>

      <!-- Music Page Header -->
      <header class="space-y-3 sm:space-y-4 pb-10 sm:pb-12 border-b border-[#181614]/[0.08] dark:border-white/[0.08]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#1DB954] animate-pulse"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-[#615B52] dark:text-[#A39D92]">
            Vinyl Archive &amp; Spotify Streaming
          </span>
        </div>
        <h1 class="font-heading text-3xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5]">
          Curated Sound Sanctuary
        </h1>
        <p class="text-sm sm:text-lg text-[#615B52] dark:text-[#A39D92] leading-relaxed max-w-2xl font-normal">
          An auditory sanctuary. Melodies that quiet the mind, stir reverence for natural order, and accompany deep strategic contemplation.
        </p>
      </header>

      <!-- Music Records Grid -->
      <div id="music-grid" class="mt-10 sm:mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {tracks.map((track) => (
          <div class="music-card group rounded-[28px] p-5 sm:p-7 bg-gradient-to-b from-[#FAF8F5] to-[#F5EFE6]/70 dark:from-[#1C1B18] dark:to-[#141312] border border-[#181614]/[0.08] dark:border-white/[0.08] hover:border-[#1DB954]/50 dark:hover:border-[#1DB954]/50 flex flex-col items-center justify-between transition-all duration-300 shadow-sm hover:shadow-[0_20px_45px_-12px_rgba(29,185,84,0.14)]">
            
            <!-- Spinning Vinyl Record Disc (Spins while Spotify is playing, stops when paused) -->
            <div class="py-2 sm:py-4 flex justify-center w-full">
              <div class="relative w-32 h-32 sm:w-40 sm:h-40 flex items-center justify-center">
                <div
                  class="record-disc w-32 h-32 sm:w-40 sm:h-40 rounded-full vinyl-disc relative flex items-center justify-center shadow-lg transition-transform duration-300 cursor-pointer active:scale-95 touch-manipulation select-none"
                  data-disc-spotify={track.spotifyId}
                  role="button"
                  tabindex="0"
                  aria-label={`Toggle playback for ${track.title}`}
                  title={`Click or tap to play/pause ${track.title}`}
                >
                  <div class="absolute inset-0 rounded-full border border-white/10 pointer-events-none"></div>
                  <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-[#161514] flex items-center justify-center shadow-inner pointer-events-none">
                    <img
                      src={track.coverImage}
                      alt={`${track.title} Spotify Album Cover`}
                      class="w-full h-full object-cover select-none"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="absolute w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-[#FAF8F5] dark:bg-[#121110] border-2 border-[#D4A373]"></div>
                  </div>
                  <div class="disc-play-overlay absolute inset-0 rounded-full bg-black/35 backdrop-blur-[1px] opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white pointer-events-none">
                    <span class="disc-action-icon text-[11px] font-mono font-bold tracking-wider">PLAY</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Title & Musicians -->
            <div class="w-full text-center pt-2 pb-2.5 space-y-1">
              <h2 class="font-heading text-lg sm:text-xl font-semibold text-[#181614] dark:text-[#FAF8F5] leading-snug">
                {track.title}
              </h2>
              <p class="text-xs text-[#615B52] dark:text-[#A39D92] font-medium">
                {track.artist}
              </p>
              <span class="inline-block text-[11px] font-mono text-[#B27B48] font-medium pt-0.5">
                {track.ragaOrMood}
              </span>
              <p class="text-xs text-[#615B52] dark:text-[#A39D92] leading-relaxed pt-2">
                {track.description}
              </p>
            </div>

            <!-- Embedded Official Spotify Player -->
            <div class="w-full mt-3 rounded-2xl overflow-hidden shadow-xs border border-[#181614]/[0.06] dark:border-white/[0.08] bg-black/5 dark:bg-black/20 transition-all duration-300" id={`player-wrapper-${track.spotifyId}`}>
              <div
                id={`spotify-page-embed-${track.spotifyId}`}
                class="spotify-embed-slot w-full min-h-[152px]"
                data-spotify-id={track.spotifyId}
              >
                <iframe
                  id={`spotify-iframe-${track.spotifyId}`}
                  class="w-full rounded-2xl bg-transparent block"
                  src={`https://open.spotify.com/embed/track/${track.spotifyId}?utm_source=generator&theme=0`}
                  width="100%"
                  height="152"
                  frameBorder="0"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                  title={`${track.title} - Spotify Player`}
                ></iframe>
              </div>
            </div>

            <!-- Bottom Link to Spotify Client -->
            <div class="w-full pt-3 sm:pt-4 mt-2 sm:mt-3 border-t border-[#181614]/[0.06] dark:border-white/[0.08] flex items-center justify-between text-xs">
              <span
                class="playback-status-badge text-[11px] font-mono text-[#615B52] dark:text-[#A39D92] flex items-center gap-1.5"
                data-status-for={track.spotifyId}
              >
                <span class="status-indicator-dot w-1.5 h-1.5 rounded-full bg-[#615B52]/40"></span>
                <span class="status-text">Ready</span>
              </span>
              <a
                href={track.spotifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#1DB954] dark:hover:text-[#1DB954] hover:bg-[#181614]/5 dark:hover:bg-white/5 transition-colors touch-manipulation"
              >
                <span>Listen on Spotify</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Back to Sanctuary -->
      <div class="mt-14 sm:mt-16 pt-8 border-t border-[#181614]/[0.08] dark:border-white/[0.08] flex items-center justify-between">
        <a
          href="/#music"
          class="inline-flex items-center gap-2 text-xs font-semibold text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors"
        >
          <span>← Back to Sanctuary</span>
        </a>

        <div class="text-xs font-mono text-[#615B52]/60 dark:text-[#A39D92]/60">
          {tracks.length} Records In Collection
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  declare global {
    interface Window {
      onSpotifyIframeApiReady?: (IFrameAPI: any) => void;
      __SpotifyIframeAPI?: any;
    }
  }

  function setupSpotifyRecordPlayers() {
    const controllers: Record<string, any> = {};

    function updateDiscPlayback(spotifyId: string, isPlaying: boolean) {
      if (isPlaying) {
        document.querySelectorAll('[data-disc-spotify]').forEach((otherDisc) => {
          const otherId = otherDisc.getAttribute('data-disc-spotify');
          if (otherId && otherId !== spotifyId) {
            updateDiscPlayback(otherId, false);
          }
        });
      }

      const disc = document.querySelector(`[data-disc-spotify="${spotifyId}"]`);
      const statusBadge = document.querySelector(`[data-status-for="${spotifyId}"]`);

      if (disc) {
        if (isPlaying) {
          disc.classList.remove('is-paused');
          disc.classList.add('is-playing');
          const overlayIcon = disc.querySelector('.disc-action-icon');
          if (overlayIcon) overlayIcon.textContent = 'PAUSE';
        } else {
          disc.classList.remove('is-playing');
          disc.classList.add('is-paused');
          const overlayIcon = disc.querySelector('.disc-action-icon');
          if (overlayIcon) overlayIcon.textContent = 'PLAY';
        }
      }

      if (statusBadge) {
        const dot = statusBadge.querySelector('.status-indicator-dot');
        const text = statusBadge.querySelector('.status-text');
        if (isPlaying) {
          dot?.classList.remove('bg-[#615B52]/40');
          dot?.classList.add('bg-[#1DB954]', 'animate-pulse');
          if (text) text.textContent = 'Playing';
        } else {
          dot?.classList.remove('bg-[#1DB954]', 'animate-pulse');
          dot?.classList.add('bg-[#615B52]/40');
          if (text) text.textContent = 'Ready';
        }
      }
    }

    document.querySelectorAll('[data-disc-spotify]').forEach((disc) => {
      const spotifyId = disc.getAttribute('data-disc-spotify');
      if (!spotifyId) return;

      disc.addEventListener('click', () => {
        const ctrl = controllers[spotifyId];
        const isCurrentlyPlaying = disc.classList.contains('is-playing');

        if (ctrl) {
          try {
            ctrl.togglePlay();
            return;
          } catch (_) {}
        }

        const playerWrapper = document.getElementById(`player-wrapper-${spotifyId}`);
        if (playerWrapper) {
          playerWrapper.classList.add('ring-2', 'ring-[#1DB954]', 'shadow-lg');
          setTimeout(() => {
            playerWrapper.classList.remove('ring-2', 'ring-[#1DB954]', 'shadow-lg');
          }, 1500);
        }

        if (isCurrentlyPlaying) {
          updateDiscPlayback(spotifyId, false);
        }
      });
    });

    const onMessage = (event: MessageEvent) => {
      try {
        let data = event.data;
        if (typeof data === 'string') {
          try {
            data = JSON.parse(data);
          } catch (_) {
            return;
          }
        }

        if (!data) return;

        if (data.type === 'playback_update' || data.event === 'playback_update') {
          const payload = data.payload || data.data || data;
          const isPlaying = !payload.isPaused && (payload.position > 0 || payload.isBuffering);

          const iframes = document.querySelectorAll<HTMLIFrameElement>('.spotify-embed-slot iframe');
          for (let i = 0; i < iframes.length; i++) {
            const ifr = iframes[i];
            if (ifr.contentWindow === event.source) {
              const slot = ifr.closest('[data-spotify-id]');
              const sId = slot?.getAttribute('data-spotify-id');
              if (sId) {
                updateDiscPlayback(sId, isPlaying);
                return;
              }
            }
          }

          const trackUri = payload.playingURI || payload.uri || '';
          const match = trackUri.match(/track[:/]([a-zA-Z0-9]+)/);
          if (match && match[1]) {
            updateDiscPlayback(match[1], isPlaying);
          }
        }
      } catch (_) {}
    };

    window.addEventListener('message', onMessage);

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('message', onMessage);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupSpotifyRecordPlayers);
</script>

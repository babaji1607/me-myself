---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { identity } from '../../data/identity';

const notes = identity.wisdom;
---

<Layout
  title={`Writings & Philosophy — ${identity.name}`}
  description="Contemplative essays and inquiries on Advaita Vedanta, systems architecture, and regenerative agriculture."
>
  <Header />

  <main id="main-content" class="flex-1 pt-28 sm:pt-36 pb-24 md:pb-36">
    <div class="max-w-4xl mx-auto px-6 md:px-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="mb-8 flex items-center gap-2 text-xs font-mono text-[#615B52] dark:text-[#A39D92]">
        <a href="/#hero" class="hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#B27B48] font-semibold">Writings</span>
      </nav>

      <!-- Blog Page Header -->
      <header class="space-y-4 pb-12 border-b border-[#181614]/[0.08] dark:border-white/[0.08]">
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5]">
          Writings & Inquiries
        </h1>
        <p class="text-base sm:text-lg text-[#615B52] dark:text-[#A39D92] leading-relaxed max-w-2xl font-normal">
          Essays and philosophical notes bridging Advaita Vedanta, classical duty, depth psychology, and strategic systems engineering.
        </p>
      </header>

      <!-- Typical Blog Feed Layout -->
      <div class="mt-12 space-y-16 sm:space-y-20">
        {notes.map((note) => (
          <article class="group space-y-4 pb-12 border-b border-[#181614]/[0.08] dark:border-white/[0.08] last:border-b-0">
            <!-- Blog Metadata Row (Date & Author) -->
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#615B52] dark:text-[#A39D92]">
              <span class="text-[#B27B48] font-medium">{note.date || 'Autumn 2026'}</span>
              <span>•</span>
              <span>By {identity.name}</span>
              <span>•</span>
              <span>{note.influence} ({note.source})</span>
            </div>

            <!-- Blog Post Title -->
            <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5] leading-snug">
              <a
                href={`/blog/${note.id}`}
                class="hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors duration-200"
              >
                {note.title}
              </a>
            </h2>

            <!-- Aphorism Highlight Quote -->
            <blockquote class="pl-4 py-1 border-l-2 border-[#B27B48] text-sm sm:text-base text-[#181614]/90 dark:text-[#FAF8F5]/90 italic font-serif leading-relaxed">
              “{note.aphorism}”
            </blockquote>

            <!-- Blog Post Excerpt -->
            <p class="text-sm sm:text-base text-[#615B52] dark:text-[#A39D92] leading-relaxed font-normal">
              {note.reflection}
            </p>

            <!-- Read More Action -->
            <div class="pt-2">
              <a
                href={`/blog/${note.id}`}
                class="inline-flex items-center gap-2 text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] group-hover:text-[#B27B48] dark:group-hover:text-[#B27B48] transition-colors"
              >
                <span>Read full essay</span>
                <span class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Navigation Back to Sanctuary -->
      <div class="mt-16 pt-8 border-t border-[#181614]/[0.08] dark:border-white/[0.08] flex items-center justify-between">
        <a
          href="/#wisdom"
          class="inline-flex items-center gap-2 text-xs font-semibold text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors"
        >
          <span>← Back to Sanctuary</span>
        </a>

        <div class="text-xs font-mono text-[#615B52]/60 dark:text-[#A39D92]/60">
          {notes.length} Essays Published
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

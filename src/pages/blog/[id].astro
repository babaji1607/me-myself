---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { identity, type WisdomNote } from '../../data/identity';

export function getStaticPaths() {
  return identity.wisdom.map((note, index) => {
    const prev = index > 0 ? identity.wisdom[index - 1] : null;
    const next = index < identity.wisdom.length - 1 ? identity.wisdom[index + 1] : null;
    return {
      params: { id: note.id },
      props: { note, prev, next }
    };
  });
}

interface Props {
  note: WisdomNote;
  prev: WisdomNote | null;
  next: WisdomNote | null;
}

const { note, prev, next } = Astro.props;
---

<Layout
  title={`${note.title} — ${identity.name}`}
  description={note.aphorism}
>
  <Header />

  <main id="main-content" class="flex-1 pt-28 sm:pt-36 pb-24 md:pb-36">
    <article class="max-w-3xl mx-auto px-6 md:px-10">
      
      <!-- Top Navigation & Breadcrumb -->
      <nav class="mb-10 flex items-center justify-between text-xs font-mono text-[#615B52] dark:text-[#A39D92]">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors"
        >
          <span>← All Writings</span>
        </a>
        <div class="flex items-center gap-2">
          <span>{note.date || 'Autumn 2026'}</span>
          <span>•</span>
          <span>By {identity.name}</span>
        </div>
      </nav>

      <!-- Essay Header -->
      <header class="space-y-6 pb-10 border-b border-[#181614]/[0.08] dark:border-white/[0.08]">
        <!-- Influence & Source Lineage -->
        <div class="text-xs font-mono uppercase tracking-wider text-[#B27B48] font-semibold">
          {note.influence} • {note.source}
        </div>

        <!-- Main Title -->
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5] leading-[1.15]">
          {note.title}
        </h1>

        <!-- Sanskrit Verse Accent (if present) -->
        {note.sanskrit && (
          <div class="pt-2">
            <span class="inline-block px-4 py-1.5 rounded-full bg-[#B27B48]/10 dark:bg-[#B27B48]/18 border border-[#B27B48]/30 text-sm font-medium tracking-wide text-[#B27B48]">
              {note.sanskrit}
            </span>
          </div>
        )}
      </header>

      <!-- Core Aphorism Feature Callout -->
      <div class="my-10 p-6 sm:p-8 rounded-2xl bg-[#F7F4EC] dark:bg-[#1A1917] border-l-4 border-[#B27B48]">
        <blockquote class="text-lg sm:text-xl text-[#181614] dark:text-[#FAF8F5] font-serif leading-relaxed italic">
          “{note.aphorism}”
        </blockquote>
      </div>

      <!-- Essay Prose Content -->
      <div class="prose-body space-y-6 text-base sm:text-lg text-[#181614]/90 dark:text-[#FAF8F5]/90 leading-relaxed font-normal">
        {note.content && note.content.length > 0 ? (
          note.content.map((paragraph) => (
            <p class="leading-relaxed text-[#3B3731] dark:text-[#D1CBC3]">
              {paragraph}
            </p>
          ))
        ) : (
          <p class="leading-relaxed text-[#3B3731] dark:text-[#D1CBC3]">
            {note.reflection}
          </p>
        )}
      </div>

      <!-- Author Signoff Box -->
      <div class="mt-14 p-6 rounded-2xl bg-[#F5EFE6]/60 dark:bg-[#161514] border border-[#181614]/[0.08] dark:border-white/[0.08] flex items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="font-heading font-semibold text-sm text-[#181614] dark:text-[#FAF8F5]">
            Written by {identity.name}
          </div>
          <p class="text-xs text-[#615B52] dark:text-[#A39D92]">
            Half Farmer • Half Solution Architect. Inquiries grounded in Advaita, systems engineering, and organic soil.
          </p>
        </div>
        <a
          href="/#contact"
          class="shrink-0 px-4 py-2 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] border border-[#181614]/15 dark:border-white/15 hover:bg-[#181614] hover:text-[#FAF8F5] dark:hover:bg-[#FAF8F5] dark:hover:text-[#181614] transition-colors"
        >
          Inquire ↗
        </a>
      </div>

      <!-- Next / Previous Article Navigation -->
      <nav class="mt-12 pt-8 border-t border-[#181614]/[0.08] dark:border-white/[0.08] grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prev ? (
          <a
            href={`/blog/${prev.id}`}
            class="group p-4 rounded-xl border border-[#181614]/[0.06] dark:border-white/[0.08] hover:border-[#B27B48]/40 transition-colors block text-left"
          >
            <span class="text-[10px] font-mono uppercase text-[#615B52] dark:text-[#A39D92] block mb-1">
              ← Previous Essay
            </span>
            <span class="font-heading font-semibold text-sm text-[#181614] dark:text-[#FAF8F5] group-hover:text-[#B27B48] transition-colors line-clamp-1">
              {prev.title}
            </span>
          </a>
        ) : <div />}

        {next && (
          <a
            href={`/blog/${next.id}`}
            class="group p-4 rounded-xl border border-[#181614]/[0.06] dark:border-white/[0.08] hover:border-[#B27B48]/40 transition-colors block text-right"
          >
            <span class="text-[10px] font-mono uppercase text-[#615B52] dark:text-[#A39D92] block mb-1">
              Next Essay →
            </span>
            <span class="font-heading font-semibold text-sm text-[#181614] dark:text-[#FAF8F5] group-hover:text-[#B27B48] transition-colors line-clamp-1">
              {next.title}
            </span>
          </a>
        )}
      </nav>

    </article>
  </main>

  <Footer />
</Layout>

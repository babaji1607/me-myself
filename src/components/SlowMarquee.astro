---
import { identity } from '../data/identity';

const words = identity.marqueeWords;
---

<section class="py-5 border-y border-[#181614]/[0.06] dark:border-white/[0.08] bg-[#F7F4EC]/30 dark:bg-[#171614]/40 overflow-hidden relative" aria-label="Axiom Marquee">
  <!-- Gradient Edge Masks -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 md:w-40 bg-gradient-to-r from-[#FAF8F5] dark:from-[#121110] to-transparent z-10"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 md:w-40 bg-gradient-to-l from-[#FAF8F5] dark:from-[#121110] to-transparent z-10"></div>

  <div class="marquee-mask overflow-hidden">
    <div class="marquee-track flex items-center">
      <!-- Set 1 -->
      <div class="flex items-center shrink-0">
        {words.map((word) => (
          <div class="flex items-center">
            <span class="text-xs sm:text-sm font-medium tracking-wide text-[#615B52] dark:text-[#A39D92] px-6 md:px-8 whitespace-nowrap">
              {word}
            </span>
            <span class="w-1 h-1 rounded-full bg-[#B27B48]/50 shrink-0"></span>
          </div>
        ))}
      </div>

      <!-- Set 2 -->
      <div class="flex items-center shrink-0" aria-hidden="true">
        {words.map((word) => (
          <div class="flex items-center">
            <span class="text-xs sm:text-sm font-medium tracking-wide text-[#615B52] dark:text-[#A39D92] px-6 md:px-8 whitespace-nowrap">
              {word}
            </span>
            <span class="w-1 h-1 rounded-full bg-[#B27B48]/50 shrink-0"></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

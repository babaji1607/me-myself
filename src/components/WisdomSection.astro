---
import { identity } from '../data/identity';

// Display only 3 blogs on the home page as requested
const displayNotes = identity.wisdom.slice(0, 3);
---

<section id="wisdom" class="py-20 md:py-32 relative border-t border-[#181614]/[0.06] dark:border-white/[0.08] bg-[#F7F4EC]/30 dark:bg-[#171614]/30">
  <div class="max-w-6xl mx-auto px-6 md:px-10">
    <!-- Pure Typographic Section Intro -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 section-title-wrap">
      <div class="max-w-xl space-y-3">
        <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5]">
          Writing & Wisdom
        </h2>
        <p class="section-desc text-base text-[#615B52] dark:text-[#A39D92] leading-relaxed">
          Contemplative inquiries bridging Advaita Vedanta and the Gita with Jung, Adler, and Krishnamurti.
        </p>
      </div>

      <!-- Quick View All Link in Header -->
      <a
        href="/blog"
        class="hidden sm:inline-flex items-center gap-2 text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors"
      >
        <span>View all writings</span>
        <span>→</span>
      </a>
    </div>

    <!-- Clean, Aesthetic Blog Cards Grid (Tags, stickers, numbers, and min read removed) -->
    <div id="wisdom-grid" class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 lg:gap-8">
      {displayNotes.map((item) => (
        <a
          href={`/blog/${item.id}`}
          class="wisdom-card group relative p-7 sm:p-8 rounded-[28px] bg-gradient-to-b from-[#FAF8F5] via-[#FAF8F5] to-[#F5EFE6]/60 dark:from-[#1C1B18] dark:via-[#1C1B18] dark:to-[#161514] border border-[#181614]/[0.08] dark:border-white/[0.08] hover:border-[#B27B48]/50 dark:hover:border-[#C78F56]/50 shadow-[0_4px_20px_-4px_rgba(24,22,20,0.04)] dark:shadow-[0_4px_20px_-4px_rgba(0,0,0,0.3)] hover:shadow-[0_20px_40px_-12px_rgba(178,123,72,0.15)] dark:hover:shadow-[0_20px_45px_-12px_rgba(0,0,0,0.65)] hover:-translate-y-2 transition-all duration-400 ease-out flex flex-col justify-between opacity-0 translate-y-8 overflow-hidden block text-left"
        >
          <!-- Ambient Corner Glow on Hover -->
          <div class="absolute -top-16 -right-16 w-36 h-36 rounded-full bg-[#B27B48]/10 dark:bg-[#B27B48]/15 blur-2xl pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="space-y-4 relative z-10">
            <!-- Author / Lineage Source (No tags or stickers) -->
            <div class="text-xs text-[#B27B48] font-semibold tracking-wide">
              {item.influence} • {item.source}
            </div>

            <!-- Essay Title -->
            <h3 class="font-heading text-xl sm:text-2xl font-semibold text-[#181614] dark:text-[#FAF8F5] group-hover:text-[#B27B48] transition-colors duration-200 leading-snug">
              {item.title}
            </h3>

            <!-- Aphorism Pull Quote -->
            <blockquote class="relative pl-3.5 py-1.5 border-l-2 border-[#B27B48] text-xs sm:text-[13px] text-[#181614]/90 dark:text-[#FAF8F5]/90 font-medium leading-relaxed italic">
              “{item.aphorism}”
            </blockquote>

            <!-- Reflection Snippet -->
            <p class="text-xs sm:text-[13px] text-[#615B52] dark:text-[#A39D92] leading-relaxed line-clamp-3">
              {item.reflection}
            </p>
          </div>

          <!-- Bottom Card Action -->
          <div class="pt-5 mt-6 border-t border-[#181614]/[0.06] dark:border-white/[0.08] flex items-center justify-between text-xs relative z-10">
            <span class="text-[#615B52] dark:text-[#A39D92] font-medium">Read Full Essay</span>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] group-hover:text-[#B27B48] transition-colors">
              <span>Read</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Writings Action Button -->
    <div class="mt-12 flex justify-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/15 dark:border-white/15 text-xs font-semibold tracking-wide transition-all duration-300 hover:scale-105 shadow-sm focus:outline-none"
      >
        <span>View all writings</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

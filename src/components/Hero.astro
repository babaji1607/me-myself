---
import HeroShader from './HeroShader.astro';
---

<section id="hero" class="relative pt-16 sm:pt-20 md:pt-24 lg:pt-28 pb-20 md:pb-28 overflow-hidden min-h-[95vh] flex flex-col items-center">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-10 w-full flex flex-col items-center">
    <!-- 1. Expansive Full-Width Particle Shader Canvas (Top) -->
    <div id="hero-shader-wrap" class="w-full flex justify-center overflow-visible select-none">
      <HeroShader />
    </div>

    <!-- 2. Hero Text Below the Figure -->
    <div id="hero-text-block" class="mt-16 sm:mt-20 md:mt-24 lg:mt-28 text-center max-w-3xl mx-auto space-y-4 md:space-y-5 relative z-10">
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-[4.2rem] font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5] leading-[1.08]">
        <span class="block overflow-hidden py-1">
          <span class="hero-line block">Rooted in Soil.</span>
        </span>
        <span class="block overflow-hidden py-1">
          <span class="hero-line block text-[#181614]/90 dark:text-[#FAF8F5]/90">Awakened in Mind.</span>
        </span>
      </h1>
      <p class="hero-subline text-base sm:text-lg text-[#615B52] dark:text-[#A39D92] leading-relaxed max-w-xl mx-auto font-normal">
        Divided equally between physical earth and strategic solution architecture.
      </p>
    </div>
  </div>

  <!-- Quiet Award-Caliber Scroll Prompt -->
  <div class="hero-scroll-cue mt-8 md:mt-12 flex flex-col items-center gap-2 pointer-events-none">
    <span class="text-[10px] uppercase font-mono tracking-widest text-[#615B52]/60 dark:text-[#A39D92]/60">Scroll</span>
    <div class="w-[1px] h-6 bg-gradient-to-b from-[#B27B48]/70 to-transparent"></div>
  </div>
</section>

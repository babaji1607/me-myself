---
import { identity } from '../data/identity';
---

<section id="perspective" class="py-24 md:py-36 relative">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Section Header -->
    <div class="flex items-center gap-3 pb-8 border-b border-[#181614]/[0.08]">
      <span class="text-xs font-mono-meta text-[#666057] uppercase tracking-widest">02 // The Worldview</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#181614]/20"></span>
      <span class="text-xs font-medium text-[#181614]/80">Perspective & Philosophy</span>
    </div>

    <!-- Editorial Layout -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      <!-- Left Column: Visual Portrait & Inner Compass -->
      <div class="lg:col-span-5 space-y-8">
        <div class="relative group rounded-3xl overflow-hidden bg-[#F3EFE6] border border-[#181614]/[0.08] shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1000&auto=format&fit=crop"
            alt="Portrait of Julian Vance in contemplative light"
            class="w-full aspect-[4/5] object-cover object-center filter grayscale contrast-[1.05] brightness-[1.02] transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#181614]/40 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between text-xs font-mono-meta text-[#FAF8F5]">
            <span>Presence // Kyoto Studio</span>
            <span>35°01'N 135°46'E</span>
          </div>
        </div>

        <!-- Inner Compass Card -->
        <div class="p-6 rounded-2xl bg-[#F7F4EC]/80 border border-[#181614]/[0.06]">
          <span class="text-xs font-mono-meta text-[#666057] uppercase tracking-wider block mb-2">Guiding Axiom</span>
          <p class="font-serif-editorial text-lg text-[#181614] italic leading-snug">
            “The most profound digital experiences are not the ones that shout the loudest, but the ones that create a quiet space to breathe.”
          </p>
        </div>
      </div>

      <!-- Right Column: Personal Narrative & Core Values -->
      <div class="lg:col-span-7 space-y-12">
        <div class="space-y-6">
          <h2 class="font-serif-editorial text-3xl sm:text-4xl md:text-5xl text-[#181614] font-normal leading-tight">
            Prioritizing human presence in an era of relentless algorithmic noise.
          </h2>
          
          <div class="space-y-5 text-base md:text-lg text-[#666057] font-normal leading-relaxed">
            {identity.bioParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <!-- The Three Pillars of Craft -->
        <div class="pt-8 border-t border-[#181614]/[0.08] space-y-6">
          <span class="text-xs font-mono-meta text-[#666057] uppercase tracking-widest block">Core Pillars of Practice</span>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {identity.coreValues.map((value, idx) => (
              <div class="p-6 rounded-2xl bg-[#F3EFE6]/60 border border-[#181614]/[0.07] hover:border-[#181614]/20 transition-colors duration-300">
                <span class="text-xs font-mono-meta text-[#B57F50] block mb-2">0{idx + 1}</span>
                <h3 class="text-sm font-semibold text-[#181614] mb-1">{value.title}</h3>
                <span class="text-[11px] font-mono-meta text-[#666057] block mb-3">{value.subtitle}</span>
                <p class="text-xs text-[#666057] leading-relaxed">{value.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

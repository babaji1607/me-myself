---
import { identity } from '../data/identity';

const navItems = [
  { id: 'hero', number: '01', label: 'Mohit', subtitle: 'The Witness' },
  { id: 'work', number: '02', label: 'The Archetype', subtitle: 'Soil & Silicon' },
  { id: 'wisdom', number: '03', label: 'Wisdom', subtitle: 'Advaita & Philosophy' },
  { id: 'music', number: '04', label: 'Sound', subtitle: 'Sacred Audio' },
  { id: 'memories', number: '05', label: 'Memories', subtitle: 'Living Archive' },
  { id: 'contact', number: '06', label: 'Inquire', subtitle: 'Direct Correspondence' },
];
---

<!-- 1. Top-Left Quiet Brand Mark (Boundless, no top bar) -->
<aside class="fixed top-5 left-5 sm:top-6 sm:left-6 lg:top-8 lg:left-10 z-40 select-none">
  <a href="/#hero" class="group flex items-center gap-3 focus:outline-none">
    <span class="w-8 h-8 rounded-full bg-[#181614] dark:bg-[#FAF8F5] text-[#FAF8F5] dark:text-[#181614] flex items-center justify-center font-heading text-xs font-semibold tracking-wider shadow-sm transition-transform duration-300 group-hover:scale-105">
      {identity.monogram}
    </span>
    <span class="font-heading text-sm font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5] opacity-90 group-hover:opacity-100 transition-opacity">
      {identity.name}
    </span>
  </a>
</aside>

<!-- 2. Desktop Adaptive Side Dock (Screens >= lg: Self-contained liquid rail, hover expansion) -->
<div class="hidden lg:flex fixed left-6 lg:left-8 top-1/2 -translate-y-1/2 z-50 items-center justify-start select-none group/dock">

  <!-- Unified Glass Capsule: Uses consistent rounded-[26px] corner curvature in BOTH states for organic liquid expansion -->
  <nav
    id="side-dock-nav"
    class="relative overflow-hidden w-12 py-5 px-3 rounded-[26px] group-hover/dock:w-[16.5rem] group-hover/dock:p-5 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] bg-[#FAF8F5]/80 dark:bg-[#121110]/80 group-hover/dock:bg-[#FAF8F5]/95 group-hover/dock:dark:bg-[#121110]/95 backdrop-blur-xl border border-[#181614]/[0.08] dark:border-white/[0.12] shadow-[0_12px_40px_rgba(0,0,0,0.08)] dark:shadow-[0_12px_40px_rgba(0,0,0,0.5)] flex flex-col justify-between"
    aria-label="Side Navigation"
  >
    <!-- =================================================================== -->
    <!-- COLLAPSED VIEW: Self-contained rail with live section number & dots -->
    <!-- =================================================================== -->
    <div class="flex flex-col items-center gap-4 transition-all duration-250 group-hover/dock:opacity-0 group-hover/dock:pointer-events-none group-hover/dock:scale-95 absolute inset-0 py-5 px-3 justify-between">
      <!-- Live Micro-Number Indicator (Self-contained section spy) -->
      <span 
        id="dock-micro-number"
        class="font-mono text-[10px] font-semibold text-[#B27B48] tracking-widest"
      >
        01
      </span>

      <!-- 6 Vertical Navigation Track Points -->
      <div class="flex flex-col items-center gap-2.5 py-1">
        {navItems.map((item) => (
          <a
            href={`/#${item.id}`}
            class="p-0.5 focus:outline-none"
            aria-label={item.label}
          >
            <div
              data-nav-dot={item.id}
              class="w-1.5 h-1.5 rounded-full bg-[#181614]/25 dark:bg-white/30 hover:bg-[#181614]/50 dark:hover:bg-white/60 transition-all duration-300"
            ></div>
          </a>
        ))}
      </div>

      <!-- Compact Theme Icon Indicator (Clickable in collapsed rail) -->
      <button
        id="theme-toggle-collapsed"
        type="button"
        class="pt-1 text-[#615B52] dark:text-[#A39D92] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors focus:outline-none cursor-pointer"
        aria-label="Toggle theme appearance"
        title="Cycle theme: Auto / Warm Light / Dark"
      >
        <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
        </svg>
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>
    </div>

    <!-- =================================================================== -->
    <!-- EXPANDED VIEW: Complete Architectural Directory (Fixed width inner) -->
    <!-- =================================================================== -->
    <div class="w-[14rem] min-w-[14rem] flex flex-col gap-3 opacity-0 pointer-events-none group-hover/dock:opacity-100 group-hover/dock:pointer-events-auto transition-opacity duration-300 delay-100">
      <!-- Directory Top Bar -->
      <div class="flex items-center justify-between pb-2 border-b border-[#181614]/[0.06] dark:border-white/[0.08]">
        <span class="text-[9px] font-mono tracking-widest uppercase text-[#A39D92] dark:text-[#615B52]">
          Index // 06
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#B27B48]"></span>
      </div>

      <!-- Navigation Link Rows -->
      <div class="flex flex-col gap-1">
        {navItems.map((item) => (
          <a
            href={`/#${item.id}`}
            data-nav-link={item.id}
            class="group/link flex items-center justify-between px-3 py-2 rounded-xl text-xs text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] hover:bg-[#181614]/5 dark:hover:bg-white/5 transition-all duration-200"
          >
            <div class="flex items-center gap-2.5">
              <span class="font-mono text-[10px] text-[#A39D92] dark:text-[#615B52] group-hover/link:text-[#B27B48] transition-colors">
                {item.number}
              </span>
              <span class="font-heading font-medium tracking-tight">
                {item.label}
              </span>
            </div>
            <span class="text-[9px] font-mono opacity-0 group-hover/link:opacity-60 transition-opacity">
              →
            </span>
          </a>
        ))}
      </div>

      <!-- Bottom Theme Toggle Row (Adapts to System / Warm Light / Dark) -->
      <div class="pt-2 mt-1 border-t border-[#181614]/[0.06] dark:border-white/[0.08]">
        <button
          id="theme-toggle-desktop"
          type="button"
          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] hover:bg-[#181614]/5 dark:hover:bg-white/5 transition-all duration-200 focus:outline-none cursor-pointer"
          aria-label="Toggle theme mode"
          title="Click to cycle: Auto (System) → Warm Light → Dark"
        >
          <span class="font-mono text-[10px] uppercase tracking-wider">
            Theme
          </span>
          <div class="flex items-center gap-1.5 text-xs">
            <span id="theme-label-desktop" class="text-[11px] font-medium text-[#B27B48]">Auto</span>
            <!-- Sun Icon (Warm Light) -->
            <svg id="theme-icon-sun-desktop" class="w-3.5 h-3.5 text-[#B27B48] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" stroke-width="1.8"></circle>
              <path stroke-linecap="round" stroke-width="1.8" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon (Dark) -->
            <svg id="theme-icon-moon-desktop" class="w-3.5 h-3.5 text-[#B27B48] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
            </svg>
            <!-- Auto / Monitor Icon (System) -->
            <svg id="theme-icon-auto-desktop" class="w-3.5 h-3.5 text-[#B27B48] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect width="18" height="12" x="3" y="4" rx="2" stroke-width="1.8"></rect>
              <path stroke-linecap="round" stroke-width="1.8" d="M8 20h8m-4-4v4"></path>
            </svg>
          </div>
        </button>
      </div>
    </div>
  </nav>
</div>

<!-- ========================================================================= -->
<!-- 3. MOBILE & TABLET CONTROLLABLE FLOATING BOTTOM NAV BAR (Screens < lg)    -->
<!-- ========================================================================= -->

<!-- Semi-transparent Dismissal Backdrop Scrim (Tapping outside closes the upward drawer) -->
<div
  id="mobile-nav-backdrop"
  class="lg:hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-40 hidden transition-opacity duration-300"
  aria-hidden="true"
></div>

<div class="lg:hidden fixed bottom-[max(0.75rem,env(safe-area-inset-bottom,12px))] left-1/2 -translate-x-1/2 z-50 w-[calc(100%-1.25rem)] max-w-md sm:max-w-lg select-none">
  
  <!-- Upward Expanding Architectural Navigation Drawer (Opens ABOVE the bottom bar) -->
  <div
    id="mobile-sheet"
    class="hidden absolute bottom-full mb-2.5 inset-x-0 p-4 sm:p-5 rounded-3xl bg-[#FAF8F5]/96 dark:bg-[#141312]/96 backdrop-blur-2xl border border-[#181614]/[0.08] dark:border-white/[0.12] shadow-[0_20px_50px_rgba(0,0,0,0.25)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.7)] flex flex-col gap-2.5 max-h-[75vh] overflow-y-auto"
  >
    <!-- Drawer Header -->
    <div class="flex items-center justify-between pb-2.5 border-b border-[#181614]/[0.06] dark:border-white/[0.08]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#B27B48] animate-pulse"></span>
        <span class="text-[11px] font-mono tracking-wider uppercase text-[#181614] dark:text-[#FAF8F5] font-semibold">
          Directory Index // 06
        </span>
      </div>
      <button
        id="mobile-sheet-close"
        type="button"
        class="w-6 h-6 rounded-full flex items-center justify-center text-[#615B52] dark:text-[#A39D92] hover:bg-[#181614]/5 dark:hover:bg-white/10 active:scale-95 transition-transform"
        aria-label="Close menu"
      >
        ✕
      </button>
    </div>

    <!-- All 6 Architectural Sections -->
    <div class="flex flex-col gap-1 py-1">
      {navItems.map((item) => (
        <a
          href={`/#${item.id}`}
          data-mobile-sheet-link={item.id}
          class="mobile-sheet-link flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs text-[#181614] dark:text-[#FAF8F5] hover:bg-[#181614]/5 dark:hover:bg-white/5 active:bg-[#B27B48]/15 transition-all touch-manipulation"
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-[#A39D92] dark:text-[#615B52]">
              {item.number}
            </span>
            <div class="flex flex-col text-left">
              <span class="font-heading font-semibold text-sm">
                {item.label}
              </span>
              <span class="text-[10px] text-[#615B52] dark:text-[#A39D92]">
                {item.subtitle}
              </span>
            </div>
          </div>
          <span class="text-xs font-mono text-[#B27B48]">
            →
          </span>
        </a>
      ))}
    </div>

    <!-- Quick Correspondence & Direct Links Row -->
    <div class="pt-2.5 border-t border-[#181614]/[0.06] dark:border-white/[0.08] flex items-center justify-between text-xs">
      <a
        href={identity.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#181614]/5 dark:bg-white/5 text-[#181614] dark:text-[#FAF8F5] font-mono text-[10px] tracking-wider uppercase active:scale-95 transition-transform"
      >
        <span>WhatsApp</span>
        <span>↗</span>
      </a>

      <a
        href={`mailto:${identity.contact.email}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#181614]/5 dark:bg-white/5 text-[#181614] dark:text-[#FAF8F5] font-mono text-[10px] tracking-wider uppercase active:scale-95 transition-transform"
      >
        <span>Email</span>
        <span>↗</span>
      </a>

      <a
        href="/music"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#1DB954]/10 text-[#1DB954] font-mono text-[10px] tracking-wider uppercase active:scale-95 transition-transform"
      >
        <span>Records</span>
        <span>→</span>
      </a>
    </div>

    <!-- Mobile Theme Mode Switcher in Drawer -->
    <div class="pt-2 border-t border-[#181614]/[0.06] dark:border-white/[0.08]">
      <button
        id="theme-toggle-sheet"
        type="button"
        class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-xs text-[#615B52] dark:text-[#A39D92] hover:bg-[#181614]/5 dark:hover:bg-white/5 active:scale-95 transition-transform"
      >
        <span class="font-mono text-[10px] uppercase tracking-wider">Appearance Theme</span>
        <span id="theme-label-sheet" class="text-[11px] font-semibold text-[#B27B48]">Auto</span>
      </button>
    </div>
  </div>

  <!-- Direct Controllable Bottom Nav Bar Dock (Primary Tabs directly accessible with thumb!) -->
  <nav
    class="w-full px-2 py-1.5 sm:px-3 sm:py-2 rounded-full bg-[#FAF8F5]/92 dark:bg-[#141312]/92 backdrop-blur-2xl border border-[#181614]/[0.08] dark:border-white/[0.12] shadow-[0_12px_36px_rgba(0,0,0,0.16)] dark:shadow-[0_12px_36px_rgba(0,0,0,0.55)] flex items-center justify-between gap-1"
    aria-label="Mobile Bottom Navigation Bar"
  >
    <!-- Direct Tab 1: Mohit (Home) -->
    <a
      href="/#hero"
      data-bottom-tab="hero"
      class="bottom-nav-tab flex-1 py-1.5 px-2 rounded-full text-center flex flex-col items-center justify-center transition-all duration-200 text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] active:scale-95 touch-manipulation"
    >
      <span class="font-heading text-[11px] sm:text-xs font-medium tracking-tight">Mohit</span>
      <span class="tab-dot w-1 h-1 rounded-full bg-[#B27B48] mt-0.5 opacity-0 transition-opacity"></span>
    </a>

    <!-- Direct Tab 2: The Archetype (Work) -->
    <a
      href="/#work"
      data-bottom-tab="work"
      class="bottom-nav-tab flex-1 py-1.5 px-2 rounded-full text-center flex flex-col items-center justify-center transition-all duration-200 text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] active:scale-95 touch-manipulation"
    >
      <span class="font-heading text-[11px] sm:text-xs font-medium tracking-tight">Work</span>
      <span class="tab-dot w-1 h-1 rounded-full bg-[#B27B48] mt-0.5 opacity-0 transition-opacity"></span>
    </a>

    <!-- Direct Tab 3: Wisdom -->
    <a
      href="/#wisdom"
      data-bottom-tab="wisdom"
      class="bottom-nav-tab flex-1 py-1.5 px-2 rounded-full text-center flex flex-col items-center justify-center transition-all duration-200 text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] active:scale-95 touch-manipulation"
    >
      <span class="font-heading text-[11px] sm:text-xs font-medium tracking-tight">Wisdom</span>
      <span class="tab-dot w-1 h-1 rounded-full bg-[#B27B48] mt-0.5 opacity-0 transition-opacity"></span>
    </a>

    <!-- Direct Tab 4: Sound Sanctuary -->
    <a
      href="/#music"
      data-bottom-tab="music"
      class="bottom-nav-tab flex-1 py-1.5 px-2 rounded-full text-center flex flex-col items-center justify-center transition-all duration-200 text-[#615B52] dark:text-[#A39D92] hover:text-[#181614] dark:hover:text-[#FAF8F5] active:scale-95 touch-manipulation"
    >
      <span class="font-heading text-[11px] sm:text-xs font-medium tracking-tight">Music</span>
      <span class="tab-dot w-1 h-1 rounded-full bg-[#B27B48] mt-0.5 opacity-0 transition-opacity"></span>
    </a>

    <!-- Subtle Divider -->
    <div class="w-[1px] h-4 sm:h-5 bg-[#181614]/10 dark:bg-white/10 mx-0.5"></div>

    <!-- Toggle Index Drawer Button -->
    <button
      id="mobile-sheet-toggle"
      type="button"
      class="py-1.5 px-2.5 sm:px-3 rounded-full bg-[#181614] dark:bg-[#FAF8F5] text-[#FAF8F5] dark:text-[#181614] font-mono text-[10px] tracking-wider uppercase flex items-center gap-1 active:scale-95 transition-all cursor-pointer font-semibold shadow-xs"
      aria-label="Open directory index menu"
      title="Open full index"
    >
      <span id="mobile-sheet-btn-text">Index</span>
      <svg id="mobile-sheet-btn-chevron" class="w-2.5 h-2.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>

    <!-- One-Tap Theme Toggle in Dock -->
    <button
      id="theme-toggle-mobile"
      type="button"
      class="w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-[#181614] dark:text-[#FAF8F5] hover:bg-[#181614]/5 dark:hover:bg-white/10 active:scale-90 transition-transform focus:outline-none cursor-pointer"
      aria-label="Toggle appearance theme"
      title="Cycle theme: Auto → Warm Light → Dark"
    >
      <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4" stroke-width="1.8"></circle>
        <path stroke-linecap="round" stroke-width="1.8" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"></path>
      </svg>
      <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
      </svg>
    </button>
  </nav>
</div>

<script>
  function setupSideNav() {
    const sections = [
      { id: 'hero', number: '01', label: 'Mohit' },
      { id: 'work', number: '02', label: 'The Archetype' },
      { id: 'wisdom', number: '03', label: 'Wisdom' },
      { id: 'music', number: '04', label: 'Sound' },
      { id: 'memories', number: '05', label: 'Memories' },
      { id: 'contact', number: '06', label: 'Inquire' },
    ];

    let currentActiveId = '';

    // 1. UPDATE ACTIVE INDICATORS & LABELS ACROSS DESKTOP & MOBILE
    function updateActiveSection(activeId: string) {
      if (activeId === currentActiveId) return;
      currentActiveId = activeId;

      const currentSection = sections.find((s) => s.id === activeId);
      if (!currentSection) return;

      // Update Self-Contained Micro-Number on Desktop Collapsed Dock
      const microNumber = document.getElementById('dock-micro-number');
      if (microNumber) {
        microNumber.textContent = currentSection.number;
      }

      // Update Desktop Collapsed Dots
      document.querySelectorAll('[data-nav-dot]').forEach((el) => {
        const target = el.getAttribute('data-nav-dot');
        if (target === activeId) {
          el.className = 'w-1.5 h-5 rounded-full bg-[#B27B48] shadow-[0_0_10px_rgba(178,123,72,0.6)] transition-all duration-300';
        } else {
          el.className = 'w-1.5 h-1.5 rounded-full bg-[#181614]/25 dark:bg-white/30 hover:bg-[#181614]/50 dark:hover:bg-white/60 transition-all duration-300';
        }
      });

      // Update Desktop Expanded Nav Links
      document.querySelectorAll('[data-nav-link]').forEach((el) => {
        const target = el.getAttribute('data-nav-link');
        if (target === activeId) {
          el.classList.add('bg-[#B27B48]/12', 'dark:bg-[#B27B48]/20', 'text-[#B27B48]', 'dark:text-[#E2A66C]', 'font-semibold');
          el.classList.remove('text-[#615B52]', 'dark:text-[#A39D92]');
        } else {
          el.classList.remove('bg-[#B27B48]/12', 'dark:bg-[#B27B48]/20', 'text-[#B27B48]', 'dark:text-[#E2A66C]', 'font-semibold');
          el.classList.add('text-[#615B52]', 'dark:text-[#A39D92]');
        }
      });

      // Update Mobile & Tablet Bottom Dock Tabs
      document.querySelectorAll('[data-bottom-tab]').forEach((tab) => {
        const target = tab.getAttribute('data-bottom-tab');
        const dot = tab.querySelector('.tab-dot');
        if (target === activeId) {
          tab.classList.add('bg-[#B27B48]/15', 'dark:bg-[#B27B48]/25', 'text-[#B27B48]', 'dark:text-[#E2A66C]', 'font-semibold');
          tab.classList.remove('text-[#615B52]', 'dark:text-[#A39D92]');
          dot?.classList.remove('opacity-0');
          dot?.classList.add('opacity-100');
        } else {
          tab.classList.remove('bg-[#B27B48]/15', 'dark:bg-[#B27B48]/25', 'text-[#B27B48]', 'dark:text-[#E2A66C]', 'font-semibold');
          tab.classList.add('text-[#615B52]', 'dark:text-[#A39D92]');
          dot?.classList.remove('opacity-100');
          dot?.classList.add('opacity-0');
        }
      });

      // Update Mobile Sheet Links
      document.querySelectorAll('[data-mobile-sheet-link]').forEach((link) => {
        const target = link.getAttribute('data-mobile-sheet-link');
        if (target === activeId) {
          link.classList.add('bg-[#B27B48]/12', 'dark:bg-[#B27B48]/20', 'text-[#B27B48]', 'font-semibold');
        } else {
          link.classList.remove('bg-[#B27B48]/12', 'dark:bg-[#B27B48]/20', 'text-[#B27B48]', 'font-semibold');
        }
      });
    }

    // 2. AUTOMATIC SECTION SPY (Real-time Viewport Tracking)
    function onScroll() {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const viewportMiddle = scrollY + windowHeight * 0.42;

      let candidateId = sections[0].id;

      for (const section of sections) {
        const el = document.getElementById(section.id);
        if (el) {
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (viewportMiddle >= top && viewportMiddle < top + height) {
            candidateId = section.id;
            break;
          }
        }
      }

      // Edge check: near bottom of page -> contact
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 70) {
        candidateId = 'contact';
      }

      updateActiveSection(candidateId);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    const lenis = (window as any).__lenis;
    if (lenis) {
      lenis.on('scroll', onScroll);
    }
    onScroll();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      const currentLenis = (window as any).__lenis;
      if (currentLenis) {
        currentLenis.off('scroll', onScroll);
      }
    }, { once: true });

    // 3. SMOOTH SCROLL INTEGRATION & AUTOMATIC DRAWER DISMISSAL
    function closeMobileSheet() {
      const sheet = document.getElementById('mobile-sheet');
      const backdrop = document.getElementById('mobile-nav-backdrop');
      const chevron = document.getElementById('mobile-sheet-btn-chevron');
      if (sheet) sheet.classList.add('hidden');
      if (backdrop) backdrop.classList.add('hidden');
      if (chevron) chevron.classList.remove('rotate-180');
    }

    document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        closeMobileSheet();

        const href = anchor.getAttribute('href');
        if (!href) return;
        const hash = href.startsWith('/#') ? href.substring(1) : href;
        if (hash.startsWith('#')) {
          const isHome = window.location.pathname === '/' || window.location.pathname === '';
          if (isHome) {
            const targetEl = document.querySelector(hash);
            if (targetEl) {
              e.preventDefault();
              const currentLenis = (window as any).__lenis;
              if (currentLenis) {
                currentLenis.scrollTo(targetEl, { duration: 1.1, offset: 0 });
              } else {
                targetEl.scrollIntoView({ behavior: 'smooth' });
              }
            }
          }
        }
      });
    });

    // 4. SYSTEM-AWARE THEME CYCLING (Auto/System → Warm Light → Dark)
    function updateThemeUI() {
      const stored = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = document.documentElement.classList.contains('dark');

      const labelDesktop = document.getElementById('theme-label-desktop');
      const labelSheet = document.getElementById('theme-label-sheet');
      const sunDesktop = document.getElementById('theme-icon-sun-desktop');
      const moonDesktop = document.getElementById('theme-icon-moon-desktop');
      const autoDesktop = document.getElementById('theme-icon-auto-desktop');

      const text = !stored ? (isDark ? 'Auto (Dark)' : 'Auto (Warm)') : (stored === 'light' ? 'Warm Light' : 'Dark');

      if (labelDesktop) labelDesktop.textContent = text;
      if (labelSheet) labelSheet.textContent = text;

      if (!stored) {
        autoDesktop?.classList.remove('hidden');
        sunDesktop?.classList.add('hidden');
        moonDesktop?.classList.add('hidden');
      } else if (stored === 'light') {
        sunDesktop?.classList.remove('hidden');
        moonDesktop?.classList.add('hidden');
        autoDesktop?.classList.add('hidden');
      } else {
        moonDesktop?.classList.remove('hidden');
        sunDesktop?.classList.add('hidden');
        autoDesktop?.classList.add('hidden');
      }
    }

    function cycleTheme() {
      const stored = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (!stored) {
        localStorage.setItem('theme', 'light');
        document.documentElement.classList.remove('dark');
      } else if (stored === 'light') {
        localStorage.setItem('theme', 'dark');
        document.documentElement.classList.add('dark');
      } else {
        localStorage.removeItem('theme');
        if (systemDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      updateThemeUI();
    }

    const themeDesktop = document.getElementById('theme-toggle-desktop');
    const themeMobile = document.getElementById('theme-toggle-mobile');
    const themeCollapsed = document.getElementById('theme-toggle-collapsed');
    const themeSheet = document.getElementById('theme-toggle-sheet');

    if (themeDesktop) themeDesktop.addEventListener('click', cycleTheme);
    if (themeMobile) themeMobile.addEventListener('click', cycleTheme);
    if (themeCollapsed) themeCollapsed.addEventListener('click', cycleTheme);
    if (themeSheet) themeSheet.addEventListener('click', cycleTheme);

    updateThemeUI();

    try {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const handleSystemThemeChange = (e: MediaQueryListEvent) => {
        if (!localStorage.getItem('theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          updateThemeUI();
        }
      };
      mediaQuery.addEventListener('change', handleSystemThemeChange);
    } catch (err) {}

    // 5. MOBILE DRAWER & BACKDROP TOGGLES
    const mobileBtn = document.getElementById('mobile-sheet-toggle');
    const mobileSheet = document.getElementById('mobile-sheet');
    const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
    const mobileClose = document.getElementById('mobile-sheet-close');
    const mobileChevron = document.getElementById('mobile-sheet-btn-chevron');

    function toggleMobileDrawer() {
      if (!mobileSheet) return;
      const isHidden = mobileSheet.classList.contains('hidden');
      if (isHidden) {
        mobileSheet.classList.remove('hidden');
        mobileBackdrop?.classList.remove('hidden');
        mobileChevron?.classList.add('rotate-180');
      } else {
        closeMobileSheet();
      }
    }

    if (mobileBtn) {
      mobileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileDrawer();
      });
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', (e) => {
        e.stopPropagation();
        closeMobileSheet();
      });
    }

    if (mobileBackdrop) {
      mobileBackdrop.addEventListener('click', closeMobileSheet);
    }
  }

  document.addEventListener('astro:page-load', setupSideNav);
</script>

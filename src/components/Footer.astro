---
import { identity } from '../data/identity';

const { contact } = identity;
---

<footer
  id="contact"
  class="relative z-20 -mt-10 sm:-mt-14 md:-mt-20 rounded-t-[36px] sm:rounded-t-[52px] md:rounded-t-[64px] border-t border-[#181614]/[0.08] dark:border-white/[0.1] bg-[#FAF8F5] dark:bg-[#0F0E0D] shadow-[0_-25px_60px_-15px_rgba(24,22,20,0.08)] dark:shadow-[0_-30px_70px_-15px_rgba(0,0,0,0.7)] pt-16 sm:pt-20 md:pt-28 pb-16 md:pb-24 overflow-hidden"
>
  <!-- Architectural Shutter Lines Subtle Ambient Texture -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.04] bg-[linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:100%_48px]"></div>

  <div class="max-w-6xl mx-auto px-6 md:px-10 relative z-10">
    <!-- Shutter Top Centered Tactile Pill Bar -->
    <div class="flex justify-center mb-10 sm:mb-14">
      <div class="w-14 sm:w-20 h-1 sm:h-1.5 rounded-full bg-[#181614]/20 dark:bg-white/20"></div>
    </div>

    <!-- Pure Typographic Section Intro -->
    <div class="max-w-2xl space-y-3 section-title-wrap">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#B27B48]"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-[#615B52] dark:text-[#A39D92]">
          06 // Direct Correspondence
        </span>
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5]">
        Get in Touch
      </h2>
      <p class="section-desc text-base text-[#615B52] dark:text-[#A39D92] leading-relaxed">
        {contact.note}
      </p>
    </div>

    <!-- Contact Channels: 8-Slot Architectural Grid with Dedicated Icons & Names -->
    <div id="footer-content" class="mt-12 pt-8 border-t border-[#181614]/[0.08] dark:border-white/[0.08] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 opacity-0 translate-y-6">
      
      <!-- 1. Primary Email Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            Primary Email
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={`mailto:${contact.email}`}
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4 break-all"
          >
            {contact.email}
          </a>
          <button
            type="button"
            data-copy={contact.email}
            class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs cursor-pointer"
          >
            <span class="copy-label">Copy address</span>
          </button>
        </div>
      </div>

      <!-- 2. Alternate Email Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7"></path>
              <path d="M2 13a4 4 0 0 0 4 4h2.17a2 2 0 0 1 1.42.59l1.41 1.41a2 2 0 0 0 1.42.59h2.16a2 2 0 0 0 1.42-.59l1.41-1.41a2 2 0 0 1 1.42-.59H18a4 4 0 0 0 4-4"></path>
              <path d="M12 3v8"></path>
              <path d="m8 7 4 4 4-4"></path>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            Alternate Email
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={`mailto:${contact.alternateEmail || 'mohit.ashliya@zohomail.in'}`}
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4 break-all"
          >
            {contact.alternateEmail || 'mohit.ashliya@zohomail.in'}
          </a>
          <button
            type="button"
            data-copy={contact.alternateEmail || 'mohit.ashliya@zohomail.in'}
            class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs cursor-pointer"
          >
            <span class="copy-label">Copy address</span>
          </button>
        </div>
      </div>

      <!-- 3. Direct Phone Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            Direct Phone
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={`tel:${(contact.phoneRaw || contact.phone).replace(/\s+/g, '')}`}
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            {contact.phoneDisplay || contact.phone}
          </a>
          <div class="flex items-center gap-2">
            <button
              type="button"
              data-copy={contact.phoneRaw || contact.phone}
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs cursor-pointer"
            >
              <span class="copy-label">Copy</span>
            </button>
            <a
              href={`tel:${(contact.phoneRaw || contact.phone).replace(/\s+/g, '')}`}
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-transparent hover:bg-[#181614]/5 dark:hover:bg-white/5 text-[#615B52] dark:text-[#A39D92] text-xs font-medium transition-colors"
            >
              Call ↗
            </a>
          </div>
        </div>
      </div>

      <!-- 4. WhatsApp Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            WhatsApp
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            {contact.whatsapp}
          </a>
          <a
            href={contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs"
          >
            <span>Chat on WhatsApp ↗</span>
          </a>
        </div>
      </div>

      <!-- 5. LinkedIn Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.46 1.46 0 1 0 0-2.92 1.46 1.46 0 0 0 0 2.92m1.39 9.74v-8.37H5.07v8.37z"/>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            LinkedIn
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={contact.linkedinUrl || "https://www.linkedin.com/in/mohit-ashliya/"}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            in/mohit-ashliya
          </a>
          <a
            href={contact.linkedinUrl || "https://www.linkedin.com/in/mohit-ashliya/"}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs"
          >
            <span>Connect on LinkedIn ↗</span>
          </a>
        </div>
      </div>

      <!-- 6. X (Twitter) Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            X (Twitter)
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={contact.xUrl || "https://x.com/tranquil_ketu"}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            @tranquil_ketu
          </a>
          <a
            href={contact.xUrl || "https://x.com/tranquil_ketu"}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs"
          >
            <span>Follow on X ↗</span>
          </a>
        </div>
      </div>

      <!-- 7. Instagram Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            Instagram
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            {contact.instagram}
          </a>
          <a
            href={contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs"
          >
            <span>Visit Instagram ↗</span>
          </a>
        </div>
      </div>

      <!-- 8. GitHub Channel -->
      <div class="space-y-3 p-4 sm:p-5 rounded-2xl bg-[#F3EFE6]/40 dark:bg-[#161514]/40 border border-[#181614]/[0.06] dark:border-white/[0.06] hover:border-[#B27B48]/30 dark:hover:border-[#B27B48]/30 transition-all duration-300">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-[#FAF8F5] dark:bg-[#1C1B18] border border-[#181614]/10 dark:border-white/10 flex items-center justify-center text-[#B27B48] shrink-0 shadow-xs">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </span>
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[#181614] dark:text-[#FAF8F5]">
            GitHub
          </span>
        </div>
        <div class="flex flex-col items-start gap-2.5">
          <a
            href={contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading text-sm sm:text-base font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#B27B48] dark:hover:text-[#B27B48] transition-colors underline decoration-[#181614]/20 dark:decoration-white/20 underline-offset-4"
          >
            {contact.github}
          </a>
          <a
            href={contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/10 dark:border-white/10 text-xs font-medium transition-all duration-200 focus:outline-none shadow-xs"
          >
            <span>Repositories ↗</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Sign-off Row -->
    <div class="mt-14 pt-8 border-t border-[#181614]/[0.08] dark:border-white/[0.08] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#615B52] dark:text-[#A39D92]">
      <div class="flex items-center gap-6">
        {contact.socials.map((social) => (
          <a
            href={social.href}
            class="hover:text-[#181614] dark:hover:text-[#FAF8F5] transition-colors"
          >
            {social.label} ↗
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <span>{identity.location} • Rajasthan</span>
        <span>•</span>
        <span>© {new Date().getFullYear()} {identity.name}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupCopyButtons() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.copy-btn');

    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        const label = btn.querySelector('.copy-label') as HTMLElement | null;
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const original = label ? label.textContent : 'Copy';
          if (label) label.textContent = 'Copied ✓';
          btn.classList.add('bg-[#181614]', 'text-[#FAF8F5]', 'dark:bg-[#FAF8F5]', 'dark:text-[#181614]');

          setTimeout(() => {
            if (label) label.textContent = original;
            btn.classList.remove('bg-[#181614]', 'text-[#FAF8F5]', 'dark:bg-[#FAF8F5]', 'dark:text-[#181614]');
          }, 2400);
        } catch (err) {
          console.error('Failed to copy text:', err);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupCopyButtons);
</script>

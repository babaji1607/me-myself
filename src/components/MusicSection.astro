---
import { identity } from '../data/identity';

const tracks = identity.music;
---

<section id="music" class="py-20 md:py-32 relative border-t border-[#181614]/[0.06] dark:border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-6 md:px-10">
    <!-- Pure Typographic Section Intro (No index numbers or descriptive labels) -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 section-title-wrap">
      <div class="max-w-xl space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#1DB954]"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-[#615B52] dark:text-[#A39D92]">
            04 // Curated Audio & Records
          </span>
        </div>
        <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-[#181614] dark:text-[#FAF8F5]">
          Sound Sanctuary
        </h2>
        <p class="section-desc text-base text-[#615B52] dark:text-[#A39D92] leading-relaxed">
          Sacred Carnatic vibrations, timeless progressive resonance, and acoustic contemplation on vinyl & Spotify.
        </p>
      </div>

      <!-- Quick View All Music Link in Header -->
      <a
        href="/music"
        class="hidden sm:inline-flex items-center gap-2 text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#1DB954] dark:hover:text-[#1DB954] transition-colors"
      >
        <span>View all records</span>
        <span>→</span>
      </a>
    </div>

    <!-- Music Cards with Spinning Vinyl + Spotify Players -->
    <div id="music-grid" class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
      {tracks.map((track) => (
        <div
          class="music-card group rounded-[28px] p-6 bg-gradient-to-b from-[#FAF8F5] to-[#F5EFE6]/70 dark:from-[#1C1B18] dark:to-[#141312] border border-[#181614]/[0.08] dark:border-white/[0.08] hover:border-[#1DB954]/50 dark:hover:border-[#1DB954]/50 flex flex-col items-center justify-between transition-all duration-400 opacity-0 translate-y-8 shadow-sm hover:shadow-[0_20px_45px_-12px_rgba(29,185,84,0.12)] hover:-translate-y-1.5"
          data-track-id={track.id}
          data-spotify-id={track.spotifyId}
        >
          <!-- Spinning Vinyl Record Disc (Spins while Spotify is playing, stops when paused) -->
          <div class="py-3 flex justify-center w-full">
            <div class="relative w-36 h-36 sm:w-40 sm:h-40 flex items-center justify-center">
              <div
                class="record-disc w-36 h-36 sm:w-40 sm:h-40 rounded-full vinyl-disc relative flex items-center justify-center shadow-lg transition-transform duration-300 cursor-pointer"
                data-disc-spotify={track.spotifyId}
                role="button"
                tabindex="0"
                aria-label={`Toggle playback for ${track.title}`}
                title={`Click to play/pause ${track.title} on Spotify`}
              >
                <!-- Vinyl Outer Edge Rim -->
                <div class="absolute inset-0 rounded-full border border-white/10 pointer-events-none"></div>

                <!-- Center Official Spotify Album Artwork Cover with Spindle Hole -->
                <div class="relative w-18 h-18 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-[#161514] flex items-center justify-center pointer-events-none shadow-inner">
                  <img
                    src={track.coverImage}
                    alt={`${track.title} Spotify Album Cover`}
                    class="w-full h-full object-cover select-none"
                    loading="lazy"
                  />
                  <!-- Inner Spindle Hole Cutout -->
                  <div class="absolute w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-[#FAF8F5] dark:bg-[#121110] border-2 border-[#D4A373] shadow-xs"></div>
                </div>

                <!-- Subtle Play/Pause Overlay Icon on Hover -->
                <div class="disc-play-overlay absolute inset-0 rounded-full bg-black/40 backdrop-blur-[2px] opacity-0 hover:opacity-100 flex items-center justify-center transition-opacity text-white pointer-events-none">
                  <span class="disc-action-icon text-xs font-mono font-semibold">PLAY</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Track Details -->
          <div class="w-full text-center pt-2 pb-3 space-y-1">
            <h3 class="font-heading text-lg font-semibold text-[#181614] dark:text-[#FAF8F5] leading-snug">
              {track.title}
            </h3>
            <p class="text-xs text-[#615B52] dark:text-[#A39D92] font-medium line-clamp-1">
              {track.artist}
            </p>
            <span class="inline-block text-[11px] font-mono text-[#B27B48] font-medium pt-0.5">
              {track.ragaOrMood}
            </span>
          </div>

          <!-- Official Embedded Spotify Player Container -->
          <div class="w-full mt-2 rounded-2xl overflow-hidden shadow-xs border border-[#181614]/[0.06] dark:border-white/[0.08] bg-black/5 dark:bg-black/20">
            <div
              id={`spotify-embed-${track.spotifyId}`}
              class="spotify-embed-slot w-full min-h-[152px]"
              data-spotify-id={track.spotifyId}
            >
              <iframe
                class="w-full rounded-2xl bg-transparent"
                src={`https://open.spotify.com/embed/track/${track.spotifyId}?utm_source=generator&theme=0`}
                width="100%"
                height="152"
                frameBorder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
              ></iframe>
            </div>
          </div>

          <!-- Bottom Action: Live Playback Status & Open in App Link -->
          <div class="w-full pt-4 mt-3 border-t border-[#181614]/[0.06] dark:border-white/[0.08] flex items-center justify-between text-xs">
            <span
              class="playback-status-badge text-[11px] font-mono text-[#615B52] dark:text-[#A39D92] flex items-center gap-1.5"
              data-status-for={track.spotifyId}
            >
              <span class="status-indicator-dot w-1.5 h-1.5 rounded-full bg-[#615B52]/40"></span>
              <span class="status-text">Ready</span>
            </span>
            <a
              href={track.spotifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#181614] dark:text-[#FAF8F5] hover:text-[#1DB954] dark:hover:text-[#1DB954] transition-colors"
            >
              <span>Open in App</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- View All Records Action Button -->
    <div class="mt-12 flex justify-center">
      <a
        href="/music"
        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#FAF8F5] dark:bg-[#1C1B18] hover:bg-[#181614] dark:hover:bg-[#FAF8F5] text-[#181614] dark:text-[#FAF8F5] hover:text-[#FAF8F5] dark:hover:text-[#181614] border border-[#181614]/15 dark:border-white/15 text-xs font-semibold tracking-wide transition-all duration-300 hover:scale-105 shadow-sm focus:outline-none"
      >
        <span>Explore all records</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<script>
  declare global {
    interface Window {
      onSpotifyIframeApiReady?: (IFrameAPI: any) => void;
      __SpotifyIframeAPI?: any;
    }
  }

  function setupSpotifyRecordPlayers() {
    const controllers: Record<string, any> = {};

    function updateDiscPlayback(spotifyId: string, isPlaying: boolean) {
      const disc = document.querySelector(`[data-disc-spotify="${spotifyId}"]`);
      const statusBadge = document.querySelector(`[data-status-for="${spotifyId}"]`);

      if (disc) {
        if (isPlaying) {
          disc.classList.remove('is-paused');
          disc.classList.add('is-playing');
          const overlayIcon = disc.querySelector('.disc-action-icon');
          if (overlayIcon) overlayIcon.textContent = 'PAUSE';
        } else {
          disc.classList.remove('is-playing');
          disc.classList.add('is-paused');
          const overlayIcon = disc.querySelector('.disc-action-icon');
          if (overlayIcon) overlayIcon.textContent = 'PLAY';
        }
      }

      if (statusBadge) {
        const dot = statusBadge.querySelector('.status-indicator-dot');
        const text = statusBadge.querySelector('.status-text');
        if (isPlaying) {
          dot?.classList.remove('bg-[#615B52]/40');
          dot?.classList.add('bg-[#1DB954]', 'animate-pulse');
          if (text) text.textContent = 'Playing';
        } else {
          dot?.classList.remove('bg-[#1DB954]', 'animate-pulse');
          dot?.classList.add('bg-[#615B52]/40');
          if (text) text.textContent = 'Paused';
        }
      }
    }

    // Initialize with Spotify IFrame API
    function initControllers(IFrameAPI: any) {
      window.__SpotifyIframeAPI = IFrameAPI;
      const slots = document.querySelectorAll('.spotify-embed-slot');

      slots.forEach((slot) => {
        const spotifyId = slot.getAttribute('data-spotify-id');
        if (!spotifyId) return;

        const options = {
          uri: `spotify:track:${spotifyId}`,
          width: '100%',
          height: '152'
        };

        try {
          IFrameAPI.createController(slot, options, (EmbedController: any) => {
            controllers[spotifyId] = EmbedController;

            EmbedController.addListener('playback_update', (e: any) => {
              const isPlaying = !e.data.isPaused && (e.data.position > 0 || e.data.isBuffering);
              updateDiscPlayback(spotifyId, isPlaying);
            });
          });
        } catch (_) {}
      });
    }

    // Connect clicking on the vinyl record disc to play / pause
    document.querySelectorAll('[data-disc-spotify]').forEach((disc) => {
      const spotifyId = disc.getAttribute('data-disc-spotify');
      if (!spotifyId) return;

      disc.addEventListener('click', () => {
        const ctrl = controllers[spotifyId];
        if (ctrl) {
          ctrl.togglePlay();
        } else {
          // Direct fallback
          const isCurrentlyPlaying = disc.classList.contains('is-playing');
          updateDiscPlayback(spotifyId, !isCurrentlyPlaying);
        }
      });
    });

    // Setup Spotify Iframe API script loader
    if (window.__SpotifyIframeAPI) {
      initControllers(window.__SpotifyIframeAPI);
    } else {
      window.onSpotifyIframeApiReady = (IFrameAPI: any) => {
        initControllers(IFrameAPI);
      };

      if (!document.getElementById('spotify-iframe-api-script')) {
        const script = document.createElement('script');
        script.id = 'spotify-iframe-api-script';
        script.src = 'https://open.spotify.com/embed/iframe-api/v1';
        script.async = true;
        document.head.appendChild(script);
      }
    }

    // Secondary listener for Spotify cross-frame postMessage events
    const onMessage = (event: MessageEvent) => {
      try {
        const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        if (data && (data.type === 'playback_update' || data.event === 'playback_update')) {
          const payload = data.payload || data.data || data;
          const isPlaying = !payload.isPaused && (payload.position > 0 || payload.isBuffering);
          const trackUri = payload.playingURI || payload.uri || '';
          const match = trackUri.match(/track[:/]([a-zA-Z0-9]+)/);
          if (match && match[1]) {
            updateDiscPlayback(match[1], isPlaying);
          }
        }
      } catch (_) {}
    };
    window.addEventListener('message', onMessage);

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('message', onMessage);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupSpotifyRecordPlayers);
</script>
